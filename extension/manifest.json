{
  "manifest_version": 3,
  "name": "藥看仔細 SeeUrMeds",
  "short_name": "SeeUrMeds",
  "version": "0.2.0",
  "description": "在健保雲端查詢系統旁邊列出病人用藥的外觀，並把不同院所的同一種檢驗整理在一起、畫出趨勢。全部在本機瀏覽器處理，不外送病人資料。",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel"],
  "action": { "default_title": "藥看仔細 SeeUrMeds" },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": ["https://medcloud2.nhi.gov.tw/*", "https://medcloud.nhi.gov.tw/*"],
      "js": ["core.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
